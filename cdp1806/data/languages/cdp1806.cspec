<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
  <global>
    <range space="ram"/>
  </global>
  <!-- The stack is R(X), and X is R2 throughout this firmware: cold start does
       RLDI R2,89FA at 306B, and MARK hardcodes R2. SCAL, RSXD, STXD and MARK
       all DECREMENT, so growth is negative, not positive. -->
  <stackpointer register="R2" space="ram" growth="negative"/>
  <default_proto>
    <prototype name="__mem_r3" extrapop="0" stackshift="0" strategy="register">
      <input>
        <pentry minsize="2" maxsize="2">
          <register name="R3"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="1">
          <register name="D"/>
        </pentry>
      </output>
      <unaffected>
        <register name="RF"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
